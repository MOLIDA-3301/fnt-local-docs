{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocBox 纸间文档盒",
  "version": "0.6.0",
  "identifier": "com.fnt.localdocs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocBox · 纸间文档盒",
        "width": 1240,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**", "$PICTURE/**", "$VIDEO/**", "$AUDIO/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FNT · www.fornowtoday.com",
    "copyright": "Copyright © 2026 FNT · www.fornowtoday.com. All rights reserved.",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/fnt-converter"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
